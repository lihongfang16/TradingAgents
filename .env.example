# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# A-share (Chinese Stock Market) Configuration
# Enable A-share support
A_SHARE_ENABLED=true

# Primary data source for A-shares: ashare, akshare, baostock, or mairui
A_SHARE_DATA_SOURCE=ashare

# Mairui (麦蕊智数) API Configuration
# Get your licence at https://www.mairuiapi.com/getlicence
MAIRUI_LICENCE=

# AkShare configuration
AKSHARE_TIMEOUT=30
AKSHARE_ENABLE_CACHE=true

# BaoStock configuration (optional - BaoStock doesn't require auth for basic usage)
BAOSTOCK_USER_ID=
BAOSTOCK_PASSWORD=

# Ashare configuration: sina or tencent
ASHARE_PREFERENCE=sina

# Database Configuration
# For WSL2 development (Windows):
DATABASE_URL=postgresql://trading:trading123@localhost:5432/trading_db

# For Linux production:
# DATABASE_URL=postgresql://trading:password@localhost:5432/trading_db
