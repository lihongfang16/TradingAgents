FROM python:3.12-slim

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files
COPY requirements.txt requirements-web.txt ./

# Install Python dependencies (use Tsinghua mirror)
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt -r requirements-web.txt

# Copy application code - preserve directory structure
COPY cli /app/cli
COPY tradingagents /app/tradingagents
COPY web /app/web
COPY webapi /app/webapi
COPY pyproject.toml /app/

# Install the package in editable mode (use Tsinghua mirror)
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -e /app

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "web/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
